#!/bin/sh
# ==============================================================================
# r1c-apply — 把 /etc/r1c/site.conf 应用到实际网络配置（需求 §27 / §20）
#
# 设计动机：现场 PLC 网段不固定、VPN 网段也常要改，
#   因此这些参数**不编译进固件**，运行时改 site.conf 后执行本工具即可生效，
#   无需重新编译、无需重启整机。
#
# 用法:
#   r1c-apply           校验并把配置写入 UCI 后 reload 网络/防火墙
#   r1c-apply --check   只校验不改动（部署前自检）
#   r1c-apply --dry-run 只打印将要执行的 UCI 变更，不提交
#
# 覆盖范围:
#   1. LAN/PLC 侧地址（按 PLC_ROLE=gateway|host 两种角色）
#   2. WireGuard / ZeroTier 接口
#   3. 防火墙 PLC Zone 与转发规则（§20）
#   4. PLC → WAN 的访问策略、VPN→PLC 的 SNAT 策略
#
# 安全红线:
#   - 私钥只从 WG_PRIVATE_KEY_FILE 指向的文件读取，不写在 site.conf 里
#   - 本工具不执行任何 mtd / sysupgrade / U-Boot 操作（需求 §64）
# ==============================================================================

CONF="/etc/r1c/site.conf"
MODE="apply"

case "${1:-}" in
    --check)   MODE="check" ;;
    --dry-run) MODE="dryrun" ;;
    "" )       MODE="apply" ;;
    -h|--help) sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "未知参数: $1（支持 --check / --dry-run）" >&2; exit 2 ;;
esac

# ---------------------------------------------------------------- 基础工具
die() { echo "❌ $*" >&2; exit 1; }
warn() { echo "⚠️  $*"; }
info() { echo "   $*"; }
ok()   { echo "✅ $*"; }

# CIDR 前缀 -> 点分十进制掩码。busybox ash 算术即可，避免依赖 ipcalc。
cidr_to_mask() {
    local bits="${1#*/}" full=4294967295 mask
    [ "$bits" -ge 0 ] 2>/dev/null && [ "$bits" -le 32 ] 2>/dev/null || return 1
    mask=$(( (full << (32 - bits)) & full ))
    printf "%d.%d.%d.%d" \
        $(( (mask >> 24) & 255 )) $(( (mask >> 16) & 255 )) \
        $(( (mask >> 8) & 255 )) $(( mask & 255 ))
}

valid_ip() {
    local ip="$1" IFS=. p n=0
    case "$ip" in *.*.*.*) ;; *) return 1 ;; esac
    for p in $ip; do
        n=$((n + 1))
        [ "$n" -le 4 ] || return 1
        case "$p" in ''|*[!0-9]*) return 1 ;; esac
        [ "$p" -ge 0 ] 2>/dev/null && [ "$p" -le 255 ] 2>/dev/null || return 1
    done
    [ "$n" -eq 4 ]
}

valid_cidr() {
    local net="${1%%/*}" bits="${1#*/}"
    [ "$1" = "${net}/${bits}" ] || return 1
    valid_ip "$net" || return 1
    case "$bits" in ''|*[!0-9]*) return 1 ;; esac
    [ "$bits" -ge 0 ] 2>/dev/null && [ "$bits" -le 32 ] 2>/dev/null || return 1
}

# ---------------------------------------------------------------- 载入并校验
[ -f "$CONF" ] || die "未找到 $CONF"
# shellcheck disable=SC1090
. "$CONF"

echo "=============================================="
echo " r1c-apply — 应用现场配置"
echo " Site: ${SITE_ID:-UNSET}   Mode: $MODE"
echo "=============================================="

ERRS=0

# --- 必填项 ---
[ -n "${SITE_ID:-}" ] || { echo "  ✗ SITE_ID 未设置"; ERRS=$((ERRS+1)); }
# 占位值必须**阻断**应用，不能只 warn：
# SITE_ID 还是 SITE000 就说明 site.conf 没按现场填过，此时应用会把 LAN 改成
# 示例网段、还会建出一个没有端点的 WireGuard 接口，网络行为变得莫名其妙。
if [ "${SITE_ID:-}" = "SITE000" ]; then
    echo "  ✗ SITE_ID 仍是出厂占位值 SITE000，拒绝应用；请先按现场填写 $CONF"
    ERRS=$((ERRS+1))
fi

valid_cidr "${PLC_NETWORK:-}" || { echo "  ✗ PLC_NETWORK 非法: ${PLC_NETWORK:-<空>}"; ERRS=$((ERRS+1)); }

case "${PLC_ROLE:-gateway}" in
    gateway)
        valid_ip "${PLC_GATEWAY:-}" || { echo "  ✗ gateway 模式下 PLC_GATEWAY 非法: ${PLC_GATEWAY:-<空>}"; ERRS=$((ERRS+1)); }
        ;;
    host)
        valid_ip "${PLC_LOCAL_IP:-}" || { echo "  ✗ host 模式下 PLC_LOCAL_IP 非法: ${PLC_LOCAL_IP:-<空>}"; ERRS=$((ERRS+1)); }
        [ -n "${PLC_SNAT:-auto}" ] || true
        case "${PLC_SNAT:-auto}" in
            auto|1) ;;
            0) warn "host 模式且 PLC_SNAT=0：需确保现场网关有回程路由到 VPN 网段，否则 PLC 回包无法到达工程师" ;;
        esac
        ;;
    *) echo "  ✗ PLC_ROLE 必须是 gateway 或 host: ${PLC_ROLE}"; ERRS=$((ERRS+1)) ;;
esac

# --- VPN ---
case "${VPN_MODE:-wireguard}" in
    wireguard)
        valid_cidr "${VPN_ADDR:-}" || { echo "  ✗ VPN_ADDR 非法: ${VPN_ADDR:-<空>}"; ERRS=$((ERRS+1)); }
        [ -n "${WG_ENDPOINT:-}" ] || warn "WG_ENDPOINT 为空，WireGuard 无法建立连接（Hub 地址未配置）"
        [ -n "${WG_PEER_PUBLIC_KEY:-}" ] || warn "WG_PEER_PUBLIC_KEY 为空，WireGuard 无法建立连接"
        if [ -z "${WG_PRIVATE_KEY_FILE:-}" ]; then
            echo "  ✗ WG_PRIVATE_KEY_FILE 未设置"; ERRS=$((ERRS+1))
        elif [ ! -f "${WG_PRIVATE_KEY_FILE}" ]; then
            warn "私钥文件不存在: ${WG_PRIVATE_KEY_FILE}（现场部署时需写入，勿提交进仓库）"
        fi
        ;;
    zerotier)
        [ -n "${ZT_NETWORK:-}" ] || warn "ZeroTier 模式未设置 ZT_NETWORK"
        ;;
    *) echo "  ✗ VPN_MODE 必须是 wireguard 或 zerotier: ${VPN_MODE}"; ERRS=$((ERRS+1)) ;;
esac

case "${PLC_WAN_ACCESS:-deny}" in deny|allow) ;; *) echo "  ✗ PLC_WAN_ACCESS 必须是 deny 或 allow"; ERRS=$((ERRS+1)) ;; esac
case "${PLC_SNAT:-auto}" in auto|0|1) ;; *) echo "  ✗ PLC_SNAT 必须是 auto / 0 / 1"; ERRS=$((ERRS+1)) ;; esac

if [ "$ERRS" -gt 0 ]; then
    die "配置校验失败（$ERRS 项），未做任何改动。请修正 $CONF 后重试。"
fi
[ "$MODE" = "check" ] && { ok "配置校验通过（未应用）"; exit 0; }

# ---------------------------------------------------------------- 生成变更
NETMASK=$(cidr_to_mask "${PLC_NETWORK}") \
    || die "无法从 PLC_NETWORK 推导掩码: ${PLC_NETWORK}"

# ⚠️ 两种角色都**不设置** LAN 的默认网关 —— 这是刻意的设计：
#   R1C 的默认路由必须始终指向 WAN（4G / 手机热点），否则 VPN 隧道自身的
#   出站流量会走错接口，隧道立刻中断。host 模式下若给 lan 配置 gateway，
#   会产出第二条默认路由与其竞争，是本工具最容易踩的坑。
#
#   PLC 侧通信不需要网关：
#     gateway 模式 —— R1C 本身就是 PLC 网段网关，同网段直连路由天然存在
#     host   模式 —— R1C 与 PLC 同处一个二层网段，同样是直连路由
#   若现场 PLC 位于**跨三层**的远端网段（非直连），才需要额外静态路由，
#   届时应手动添加 route 段，不要用 gateway 顶替。
case "${PLC_ROLE}" in
    gateway) LAN_IP="${PLC_GATEWAY}" ;;
    host)    LAN_IP="${PLC_LOCAL_IP}" ;;
esac
LAN_GW=""

# SNAT 决策：host 模式下 PLC 的网关不是 R1C，回包会走现场原网关，
# 而原网关通常没有到 VPN 网段的路由 —— 必须做源地址转换。
case "${PLC_SNAT}" in
    auto) [ "${PLC_ROLE}" = "host" ] && DO_SNAT=1 || DO_SNAT=0 ;;
    *)    DO_SNAT="${PLC_SNAT}" ;;
esac

VPN_IFACE="wg0"
[ "${VPN_MODE}" = "zerotier" ] && VPN_IFACE="zt0"

emit() { # emit <uci 命令...>
    if [ "$MODE" = "dryrun" ]; then
        echo "  uci $*"
    else
        uci "$@" || warn "uci $* 执行失败"
    fi
}

echo
echo "[1/5] LAN / PLC 侧接口（角色: ${PLC_ROLE}）"
info "ipaddr=${LAN_IP} netmask=${NETMASK}${LAN_GW:+ gateway=${LAN_GW}}"
emit set network.lan.ipaddr="${LAN_IP}"
emit set network.lan.netmask="${NETMASK}"
if [ -n "${LAN_GW}" ]; then
    emit set network.lan.gateway="${LAN_GW}"
else
    emit -q delete network.lan.gateway
fi

echo
echo "[2/5] VPN 接口（${VPN_MODE} → ${VPN_IFACE}）"
if [ "${VPN_MODE}" = "wireguard" ]; then
    # 走隧道的目标网段：未显式配置则取 VPN_ADDR 的网络部分对应的 /16 等，
    # 这里直接用 VPN_ADDR 的前缀长度推导网段，保证工程师侧可达。
    if [ -n "${WG_PEER_ALLOWED_IPS:-}" ]; then
        TUNNEL_NETS="${WG_PEER_ALLOWED_IPS}"
    else
        # 10.250.1.20/16 -> 10.250.0.0/16
        # 用 read 分词而非 set --，避免污染脚本位置参数
        _ip="${VPN_ADDR%%/*}"; _bits="${VPN_ADDR##*/}"
        IFS=. read -r _o1 _o2 _o3 _o4 <<EOF
$_ip
EOF
        case "$_bits" in
            8)  TUNNEL_NETS="$_o1.0.0.0/8" ;;
            16) TUNNEL_NETS="$_o1.$_o2.0.0/16" ;;
            24) TUNNEL_NETS="$_o1.$_o2.$_o3.0/24" ;;
            32)
                # /32 常见于 Hub 分发给客户端的单地址（如 10.0.0.9/32），无法反推网段。
                # 绝不可退化成 0.0.0.0/0：那样 route_allowed_ips=1 会把默认路由指进隧道，
                # WAN(手机热点) 随之不可达 → 端点不可达 → 隧道自身断流（自杀）。
                echo "  ✗ VPN_ADDR=${VPN_ADDR} 是 /32，无法推导走隧道路由，必须显式设置 WG_PEER_ALLOWED_IPS" >&2
                echo "    例如单个 Hub 网段：WG_PEER_ALLOWED_IPS=\"10.0.0.0/24\"" >&2
                exit 1
                ;;
            *)  TUNNEL_NETS="0.0.0.0/0" ;;
        esac
    fi
    info "隧道地址=${VPN_ADDR}  走隧道路由=${TUNNEL_NETS}"
    emit set network.${VPN_IFACE}=interface
    emit set network.${VPN_IFACE}.proto='wireguard'
    emit set network.${VPN_IFACE}.addresses="${VPN_ADDR}"
    if [ -f "${WG_PRIVATE_KEY_FILE:-}" ]; then
        # dry-run 下不得回显私钥：这种输出常被粘到工单 / 聊天记录里
        if [ "$MODE" = "dryrun" ]; then
            echo "  uci set network.${VPN_IFACE}.private_key=<读取自 ${WG_PRIVATE_KEY_FILE}>"
        else
            emit set network.${VPN_IFACE}.private_key="$(cat "${WG_PRIVATE_KEY_FILE}")"
        fi
    else
        warn "跳过私钥（文件不存在）: ${WG_PRIVATE_KEY_FILE}"
    fi
    # peer 段
    emit set network.wg_peer=wireguard_${VPN_IFACE}
    emit set network.wg_peer.public_key="${WG_PEER_PUBLIC_KEY}"
    # 预共享密钥(PSK)：很多 Hub 端生成 client conf 时会附带 PresharedKey，
    # 本端不带而 Hub 要求 PSK 时会握手失败（且日志里往往只表现为 handshake timeout）。
    # 与私钥同样处理 —— 只从文件读，不写进 site.conf（该文件会进公开仓库）。
    if [ -n "${WG_PRESHARED_KEY_FILE:-}" ]; then
        if [ -f "${WG_PRESHARED_KEY_FILE}" ]; then
            if [ "$MODE" = "dryrun" ]; then
                echo "  uci set network.wg_peer.preshared_key=<读取自 ${WG_PRESHARED_KEY_FILE}>"
            else
                emit set network.wg_peer.preshared_key="$(cat "${WG_PRESHARED_KEY_FILE}")"
            fi
        else
            warn "跳过 PSK（文件不存在）: ${WG_PRESHARED_KEY_FILE}"
        fi
    fi
    emit set network.wg_peer.allowed_ips="${TUNNEL_NETS}"
    emit set network.wg_peer.route_allowed_ips='1'
    emit set network.wg_peer.persistent_keepalive="${WG_KEEPALIVE:-25}"
    if [ -n "${WG_ENDPOINT:-}" ]; then
        emit set network.wg_peer.endpoint_host="${WG_ENDPOINT%%:*}"
        emit set network.wg_peer.endpoint_port="${WG_ENDPOINT##*:}"
    fi
else
    info "ZeroTier network=${ZT_NETWORK}  通告路由=${ZT_ROUTE:-${PLC_NETWORK}}"
    emit set zerotier.r1c=zerotier
    emit set zerotier.r1c.enabled='1'
    emit set zerotier.r1c.network="${ZT_NETWORK}"
fi

echo
echo "[3/5] 防火墙 PLC Zone（需求 §20）"

# OpenWrt 默认配置已存在一个绑定 lan 接口的 zone（name='lan'），且自带
# lan → wan 的 forwarding。若在此基础上再新建一个同样绑定 lan 的 plc zone，
# 一个接口就会同时归属两个 zone，fw4 规则生成结果不可预期 ——
# 典型症状：默认 lan→wan 转发仍然生效，PLC 得以访问 Internet，违反需求 §20
# 「Internet → PLC / PLC → WAN 默认禁止」。因此先把冲突段清理掉。
cleanup_default_lan() {
    local sec sid
    local victims=""
    for sid in $(uci -q show firewall 2>/dev/null \
                 | grep '\.network=' | grep -w 'lan' \
                 | sed 's/^firewall\.\([^.=]*\)\..*/\1/'); do
        [ "$sid" = "plc" ] && continue
        victims="$victims $sid"
    done
    # forwarding 的 src/dest 引用的是 zone name，删掉 lan zone 后这些段失去意义
    for sid in $(uci -q show firewall 2>/dev/null \
                 | grep -E "\.(src|dest)='lan'$" \
                 | sed 's/^firewall\.\([^.=]*\)\..*/\1/'); do
        victims="$victims $sid"
    done
    for sec in $victims; do
        [ -n "$sec" ] || continue
        emit -q delete "firewall.$sec"
    done
    [ -n "$victims" ] && info "已清理默认 lan zone 段:$victims（避免与 plc zone 冲突）"
    return 0
}
cleanup_default_lan

# PLC 侧就是 lan 接口
emit set firewall.plc=zone
emit set firewall.plc.name='plc'
emit set firewall.plc.network='lan'
emit set firewall.plc.input='ACCEPT'
emit set firewall.plc.output='ACCEPT'
emit set firewall.plc.forward='REJECT'

# VPN zone：默认拒绝从 VPN 访问路由器自身（§62：WAN 禁止管理，VPN 侧按管理员授权另开）
emit set firewall.vpn=zone
emit set firewall.vpn.name='vpn'
emit set firewall.vpn.network="${VPN_IFACE}"
emit set firewall.vpn.input='REJECT'
emit set firewall.vpn.output='ACCEPT'
emit set firewall.vpn.forward='REJECT'

# VPN -> PLC: ALLOW（§20）
emit set firewall.vpn2plc=forwarding
emit set firewall.vpn2plc.src='vpn'
emit set firewall.vpn2plc.dest='plc'

# vpn zone 的 input 是 REJECT —— 这是有意的：VPN 侧不得随意触碰管理面。
# 但远程维护是本项目的一等需求，工程师必须能从 VPN 侧 SSH 进 R1C 排障，
# 否则设备一出问题就只能跑现场。因此按最小暴露放行两项：
#   SSH(22) 与 ICMP echo-request，其余管理面（LuCI/HTTP 等）仍然拒绝。
# 后续接入「远程维护开关 + 超时」后，这两条应由开关控制。
emit set firewall.vpn_ssh=rule
emit set firewall.vpn_ssh.name='Allow-VPN-SSH'
emit set firewall.vpn_ssh.src='vpn'
emit set firewall.vpn_ssh.proto='tcp'
emit set firewall.vpn_ssh.dest_port='22'
emit set firewall.vpn_ssh.family='ipv4'
emit set firewall.vpn_ssh.target='ACCEPT'
emit set firewall.vpn_icmp=rule
emit set firewall.vpn_icmp.name='Allow-VPN-ICMP'
emit set firewall.vpn_icmp.src='vpn'
emit set firewall.vpn_icmp.proto='icmp'
emit set firewall.vpn_icmp.icmp_type='echo-request'
emit set firewall.vpn_icmp.family='ipv4'
emit set firewall.vpn_icmp.target='ACCEPT'

# VPN 侧管理后台（LuCI / 本地应急管理页跑 HTTP 80，uhttpd 另有 443）
#
# ⚠️ 出厂必须是 deny。新刷出来的设备 root 是**空密码**，一旦无条件放行，
#    任何握到 WG 密钥/PSK 的对端都能匿名登录后台改配置 —— 管理面等于裸奔。
#    所以这里做成 site.conf 显式开关，外加一道硬校验：root 没有密码哈希时，
#    即便填了 allow 也拒绝放行（2026-10-08 定；这条原则别放宽）。
emit_vpn_http_rule() {
    emit set firewall.vpn_http=rule
    emit set firewall.vpn_http.name='Allow-VPN-HTTP'
    emit set firewall.vpn_http.src='vpn'
    emit set firewall.vpn_http.proto='tcp'
    emit set firewall.vpn_http.dest_port='80 443'
    emit set firewall.vpn_http.family='ipv4'
    emit set firewall.vpn_http.target='ACCEPT'
}

# 清掉历史遗留的同名规则（例如手工 uci add 出来的 cfgXXXX 段），保证幂等 ——
# 否则开关反复切换会累积出多条重复规则，排障时很难看清哪条在生效。
for _http_sid in $(uci -q show firewall 2>/dev/null \
                   | grep "name='Allow-VPN-HTTP'" \
                   | sed 's/^firewall\.\([^.=]*\)\..*/\1/'); do
    [ "$_http_sid" = "vpn_http" ] && continue
    emit -q delete "firewall.$_http_sid"
done

case "${VPN_HTTP_ACCESS:-deny}" in
    allow)
        # /etc/shadow 第二字段：空 / ! 开头（锁定）/ * （不允许密码登录）都算没设密码
        _root_pw=$(grep '^root:' /etc/shadow 2>/dev/null | cut -d: -f2)
        case "$_root_pw" in
            ''|'!'*|'*')
                warn "VPN_HTTP_ACCESS=allow，但 root 仍无密码 —— 拒绝放行管理后台"
                info "先在设备上执行 passwd root，再重新 r1c-apply"
                emit -q delete firewall.vpn_http
                ;;
            *)
                emit_vpn_http_rule
                info "VPN 侧管理后台已放行：HTTP 80 / HTTPS 443"
                ;;
        esac
        ;;
    *)
        emit -q delete firewall.vpn_http
        [ "${VPN_HTTP_ACCESS:-deny}" = "deny" ] || \
            warn "VPN_HTTP_ACCESS 取值非法（${VPN_HTTP_ACCESS}），按 deny 处理"
        ;;
esac

# PLC -> WAN: 按现场要求（默认 deny，§20）
emit set firewall.plc2wan=forwarding
emit set firewall.plc2wan.src='plc'
emit set firewall.plc2wan.dest='wan'
if [ "${PLC_WAN_ACCESS}" = "allow" ]; then
    emit set firewall.plc2wan.target='ACCEPT'
else
    emit set firewall.plc2wan.target='REJECT'
fi

echo
echo "[4/5] SNAT 策略（PLC_SNAT=${PLC_SNAT} → 实际 ${DO_SNAT}）"
if [ "$DO_SNAT" = "1" ]; then
    # ⚠️ 2026-10-07 真机踩坑：不能用「firewall.plc_snat=nat + src=vpn」这条独立 nat 规则。
    # fw4 按 **src zone** 决定规则归属链，src='vpn' 会把它放进 srcnat_vpn，
    # 而 srcnat_vpn 只在 **出口为 wg0** 时才被 jump —— 我们恰恰需要出口为 br-lan 时做 NAT，
    # 结果规则永不命中（counter 恒为 0），工程师 ping PLC 全丢。
    # 正确做法：在 **plc zone** 上开 masq，并用 masq_src 限定只对来自 VPN 网段的流量生效，
    # 这样 fw4 生成的是 srcnat_plc（oifname br-lan）里的 `ip saddr <VPN网段> masquerade`。
    info "对 VPN→PLC 流量做源地址转换（host 模式下保证 PLC 回包经过 R1C）"
    emit set firewall.plc.masq='1'
    emit set firewall.plc.masq_src="${TUNNEL_NETS}"
    emit -q delete firewall.plc_snat
else
    info "不做 SNAT（gateway 模式下 PLC 网关即 R1C，回包天然经过本设备）"
    emit set firewall.plc.masq='0'
    emit -q delete firewall.plc.masq_src
    emit -q delete firewall.plc_snat
fi

echo
echo "[5/5] 多 WAN 与自动切换（机制: ${WAN_FAILOVER:-mwan3}）"

# --- USB 网卡探测 -------------------------------------------------------------
# 4G 模块（HiLink 类）与手机 USB 共享网络，在切换/连接之后都表现为一张**USB 网卡**，
# 只能靠驱动名区分：
#   cdc_ncm / huawei_cdc_ncm / cdc_ether  → 4G 模块（实测华为 E3131 走 cdc_ether → eth1）
#   rndis_host                            → 手机 USB 共享网络
#
# ⚠️ 判断依据必须是"有没有网络接口"，**不能看 lsusb**：
#    识别到 USB 设备 ≠ 已切换成网卡。未切换的模块还停在 U 盘模式（如 12d1:1f01），
#    lsusb 看得到它，但系统里一个网络接口都没有。
#    （2026-10-08 实测：opkg install usb-modeswitch 后由 hotplug 自动切换，
#     12d1:1f01 → 12d1:14db，cdc_ether 随即注册出 eth1。）
detect_usb_net() { # detect_usb_net <驱动名...>
    for _d in /sys/class/net/*; do
        [ -e "$_d/device/uevent" ] || continue
        _drv=$(sed -n 's/^DRIVER=//p' "$_d/device/uevent" 2>/dev/null)
        for _want in "$@"; do
            if [ "$_drv" = "$_want" ]; then echo "${_d##*/}"; return 0; fi
        done
    done
    return 1
}

wan_iface_of() { # 关键字 → uci 接口名
    case "$1" in
        ethernet)  echo wan ;;
        usb4g)     echo wan4g ;;
        usbtether) echo wantether ;;
        wifi)      echo wwan ;;
        *)         return 1 ;;
    esac
}

if [ "${WAN_FAILOVER:-mwan3}" = "off" ]; then
    info "WAN_FAILOVER=off —— 不做多 WAN 切换，维持现状"
else
    # mwan3 未装时自动退化为 metric（装了却没有二进制会很尴尬，别直接放弃）
    DO_MWAN=0
    case "${WAN_FAILOVER:-mwan3}" in
        mwan3)
            if command -v mwan3 >/dev/null 2>&1; then DO_MWAN=1
            else warn "mwan3 未安装，退化为 metric 方式"; fi ;;
        metric) ;;
        *)  warn "WAN_FAILOVER 取值非法（${WAN_FAILOVER}），按 metric 处理" ;;
    esac

    # 找 wan 防火墙 zone —— 新增的 WAN 接口必须进这个 zone，否则出站不做 NAT，
    # 表现为"接口拿到 IP、ping 得通网关，但访问不了公网"。
    WAN_ZONE=""
    for _z in $(uci -q show firewall 2>/dev/null \
                | sed -n 's/^firewall\.\([^.=]*\)=zone$/\1/p'); do
        [ "$(uci -q get "firewall.$_z.name" 2>/dev/null)" = "wan" ] && WAN_ZONE="$_z"
    done
    [ -n "$WAN_ZONE" ] || warn "未找到 wan 防火墙 zone，新增 WAN 接口可能不会被 NAT"

    if [ "$DO_MWAN" = "1" ]; then
        # 清掉 mwan3 出厂自带的示例配置。
        # ⚠️ 不清理的后患很隐蔽：那套虚构的 wan/wanb/wan6/wanb6 与本设备真实接口
        #    对不上，`mwan3 status` 会显示一堆 unreachable / tracking is paused，
        #    排障时极易被误导成"网络坏了"，实际它只是从来没配过。
        for _s in $(uci -q show mwan3 2>/dev/null \
                    | sed -n 's/^mwan3\.\([^.=]*\)=.*/\1/p' | sort -u); do
            emit -q delete "mwan3.$_s"
        done
        emit set mwan3.globals=globals
        emit set mwan3.globals.mmx_mask='0x3F00'
        emit set mwan3.globals.logging='1'
    fi

    _i=0
    MEMBERS=""
    for _kw in ${WAN_PRIORITY:-ethernet usb4g usbtether wifi}; do
        _iface=$(wan_iface_of "$_kw") || { warn "WAN_PRIORITY 含未知关键字 '$_kw'，跳过"; continue; }
        _dev=""
        case "$_kw" in
            usb4g)
                _dev="${WAN_4G_DEVICE:-auto}"
                [ "$_dev" = "auto" ] && _dev=$(detect_usb_net cdc_ncm huawei_cdc_ncm cdc_ether)
                if [ -z "$_dev" ]; then
                    info "未检测到 4G 网卡（模块未插 / 还停在 U 盘模式），跳过 usb4g"
                    continue
                fi
                emit set network.wan4g=interface
                emit set network.wan4g.device="$_dev"
                emit set network.wan4g.proto='dhcp'
                ;;
            usbtether)
                _dev="${WAN_TETHER_DEVICE:-auto}"
                [ "$_dev" = "auto" ] && _dev=$(detect_usb_net rndis_host)
                if [ -z "$_dev" ]; then
                    info "未检测到 USB 共享网络，跳过 usbtether"
                    continue
                fi
                emit set network.wantether=interface
                emit set network.wantether.device="$_dev"
                emit set network.wantether.proto='dhcp'
                ;;
            wifi)
                # STA 由 wireless 配置里的 network=wwan 绑定，此处不设 device，
                # 写了反而会和无线配置打架（接口起不来）。
                emit set network.wwan=interface
                emit set network.wwan.proto='dhcp'
                _dev="(STA)"
                ;;
            ethernet)
                # eth0.2 是设备出厂就有的 WAN 口，接口段已存在，只补协议与 metric
                _dev="eth0.2"
                emit set network.wan=interface
                emit set network.wan.proto='dhcp'
                ;;
        esac

        _i=$((_i + 1))
        _metric=$((_i * 10))

        # 基础选路：即使 mwan3 没跑起来，内核也会按 metric 挑默认路由，
        # 保证"主用掉了至少还有备份"这条底线。
        emit set "network.$_iface.metric=$_metric"

        # ⚠️ 必须清掉 defaultroute=0 / peerdns=0 这类"只拿地址不拿路由"的限制。
        #    调试 4G 时常有人（包括我）为了防止抢现有上行而临时加上它，
        #    但多 WAN 场景下每个接口都**必须**拿到默认路由，由 metric 决定谁生效：
        #    留着 defaultroute=0 的表现是"接口明明在线、ping 得通，mwan3 却判它 offline"，
        #    排查起来非常费劲。这里统一清理，保证 apply 一次就能真正启用。
        emit -q delete "network.$_iface.defaultroute"
        emit -q delete "network.$_iface.peerdns"

        if [ -n "$WAN_ZONE" ]; then
            case " $(uci -q get "firewall.$WAN_ZONE.network" 2>/dev/null) " in
                *" $_iface "*) : ;;
                *) emit add_list "firewall.$WAN_ZONE.network=$_iface" ;;
            esac
        fi

        if [ "$DO_MWAN" = "1" ]; then
            emit set "mwan3.$_iface=interface"
            emit set "mwan3.$_iface.enabled=1"
            emit set "mwan3.$_iface.track_ip=${MWAN_TRACK_IPS:-223.5.5.5 114.114.114.114}"
            emit set "mwan3.$_iface.reliability=1"
            emit set "mwan3.$_iface.count=1"
            emit set "mwan3.$_iface.timeout=4"
            emit set "mwan3.$_iface.interval=10"
            emit set "mwan3.$_iface.down=5"
            emit set "mwan3.$_iface.up=5"
            emit set "mwan3.${_iface}_m${_metric}=member"
            emit set "mwan3.${_iface}_m${_metric}.interface=$_iface"
            emit set "mwan3.${_iface}_m${_metric}.metric=$_metric"
            emit set "mwan3.${_iface}_m${_metric}.weight=10"
        fi
        MEMBERS="$MEMBERS ${_iface}_m${_metric}"
        info "上行 #${_i}: ${_kw} → ${_iface}（${_dev}）metric=${_metric}"
    done

    if [ "$DO_MWAN" = "1" ] && [ -n "$MEMBERS" ]; then
        # ⚠️⚠️ 这里必须是 **failover（metric 递增）**，绝不能用 balanced 负载均衡。
        # WireGuard 是**单条 UDP 流**：一旦 mwan3 在两条上行间做均衡，
        # 同一个 WG 会话的源 IP 会来回跳，Hub 端看到的 endpoint 反复变化，
        # 表现为隧道每隔几分钟重建一次、PLC 侧间歇性不通，而且极难定位。
        # metric 递增 = 同一时刻只有一个接口承载流量，切走时才换，WG 能正常 roaming。
        emit set mwan3.r1c_failover=policy
        emit -q delete mwan3.r1c_failover.use_member
        for _m in $MEMBERS; do
            emit add_list "mwan3.r1c_failover.use_member=$_m"
        done
        emit set mwan3.r1c_default_v4=rule
        emit set mwan3.r1c_default_v4.dest_ip='0.0.0.0/0'
        emit set mwan3.r1c_default_v4.family='ipv4'
        emit set mwan3.r1c_default_v4.use_policy='r1c_failover'
        ok "mwan3 已生成 failover 策略（优先级: ${MEMBERS# }）"
    fi
fi

echo
if [ "$MODE" = "dryrun" ]; then
    ok "dry-run 结束，未提交任何变更"
    exit 0
fi

uci commit network
uci commit firewall
[ "${DO_MWAN:-0}" = "1" ] && uci commit mwan3
[ "${VPN_MODE}" = "zerotier" ] && uci commit zerotier

# 生效：重载网络与防火墙，不重启整机（需求 §37：禁止无条件重启路由器）
/etc/init.d/firewall reload >/dev/null 2>&1 || warn "firewall reload 失败"
if [ "${VPN_MODE}" = "wireguard" ] && [ -f "${WG_PRIVATE_KEY_FILE:-}" ] && [ -n "${WG_ENDPOINT:-}" ]; then
    ifup "${VPN_IFACE}" >/dev/null 2>&1 || warn "ifup ${VPN_IFACE} 失败"
fi
# mwan3 重启会重建策略路由表与 iptables 规则 —— 隧道通常会抖一下再自愈
# （WireGuard 有 roaming，几秒内恢复）。这是预期行为，不是故障。
if [ "${DO_MWAN:-0}" = "1" ]; then
    /etc/init.d/mwan3 enable >/dev/null 2>&1
    /etc/init.d/mwan3 restart >/dev/null 2>&1 \
        || warn "mwan3 重启失败，可手工执行 /etc/init.d/mwan3 restart"
fi
# LAN 地址变更需要重启 lan 接口才生效
ifup lan >/dev/null 2>&1 || warn "ifup lan 失败"

ok "配置已应用。可用 r1c-status / r1c-diagnose 验证。"
echo "   提示：若刚改过 PLC 网段，请确认 PLC_DEVICES 里的 IP 也已同步更新。"
exit 0
