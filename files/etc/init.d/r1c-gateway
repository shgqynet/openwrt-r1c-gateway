#!/bin/sh /etc/rc.common
# ==============================================================================
# r1c-gateway — 网关主服务（需求 §49）
#
# 职责：状态检测 / VPN 状态 / WAN 检测 / PLC 检测 / LED / 自动恢复 / 日志
# 阶段：Phase 1 骨架；检测与恢复逻辑在 Phase 2-9 填充
# ==============================================================================

START=95
STOP=10
USE_PROCD=1

CONF="/etc/r1c/site.conf"
LOG_TAG="r1c-gateway"

# 日志分类（需求 §41）
log_msg() {
    local cat="$1"; shift
    logger -t "$LOG_TAG" "[$cat] $*"
}

boot() {
    [ -f "$CONF" ] && . "$CONF" || { logger -t "$LOG_TAG" "[SYSTEM] site.conf missing"; return 1; }
    log_msg SYSTEM "boot: site=${SITE_ID:-UNSET} vpn_mode=${VPN_MODE:-wireguard}"
    # 启动顺序（需求 §19）：Internet -> NTP -> VPN，禁止时间错误时立刻起 VPN
    log_msg SYSTEM "boot: waiting for NTP sync before VPN"
}

start_service() {
    [ -f "$CONF" ] && . "$CONF" || { logger -t "$LOG_TAG" "[SYSTEM] site.conf missing"; return 1; }

    # 启动时按 site.conf 应用网络配置（需求 §27）。
    # 现场 PLC/VPN 网段不固定，配置必须在运行时生效而非编译进固件。
    # 只在校验通过时才应用，避免残缺配置把网络改坏；AUTO_APPLY=0 可关闭。
    if [ "${AUTO_APPLY:-1}" = "1" ] && [ -x /usr/bin/r1c-apply ]; then
        if /usr/bin/r1c-apply --check >/dev/null 2>&1; then
            log_msg SYSTEM "auto-apply site.conf (role=${PLC_ROLE:-gateway} net=${PLC_NETWORK:-UNSET})"
            /usr/bin/r1c-apply >/dev/null 2>&1 \
                && log_msg SYSTEM "auto-apply 成功" \
                || log_msg SYSTEM "auto-apply 失败，保留现有网络配置"
        else
            log_msg SYSTEM "site.conf 校验未通过，跳过 auto-apply（保留现有网络配置）"
        fi
    fi

    procd_open_instance
    procd_set_param command /bin/sh -c '
        . /etc/r1c/site.conf
        while true; do
            # TODO(Phase 2+): 调用 r1c-gateway 主循环
            #   1. WAN/Internet 检测（UP + 网关 + DNS + 可达性）
            #   2. NTP 时间校验
            #   3. VPN 状态检测与恢复
            #   4. PLC 网络可达性检测（只 ping + TCP，禁止协议写操作）
            #   5. LED 状态更新
            #   6. 分级日志：SYSTEM / WAN / VPN / PLC / MODEM / SECURITY
            sleep "${CHECK_INTERVAL:-30}"
        done
    '
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    log_msg SYSTEM "service started (site=${SITE_ID:-UNSET})"
}

stop_service() {
    log_msg SYSTEM "service stopped"
}

reload_service() {
    stop
    start
}
