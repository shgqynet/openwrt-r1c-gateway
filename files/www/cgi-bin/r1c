</style>
</head>
<body>
<div class="wrap">
EOF
    printf '<h1>R1C 网关 — %s</h1>\n' "$(h "$_title")"
    printf '<div class="sub">本地应急管理页 · 仅可从内网访问 · %s</div>\n' "$(date '+%Y-%m-%d %H:%M:%S')"
    _p="${PAGE:-status}"
    cat <<EOF
<nav>
<a href="?p=status" class="$([ "$_p" = status ] && echo cur)">运行状态</a>
<a href="?p=wifi" class="$([ "$_p" = wifi ] && echo cur)">WiFi 上行</a>
<a href="?p=site" class="$([ "$_p" = site ] && echo cur)">站点与 PLC</a>
<a href="?p=diag">诊断报告</a>
<a href="?p=log" class="$([ "$_p" = log ] && echo cur)">应用日志</a>
</nav>
