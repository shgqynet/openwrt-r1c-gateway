#!/bin/sh
# R1C 工业远程网关 —— 本地应急管理页
#
# ⚠️ 为什么是这个形态（别改成 LuCI 页面，除非固件里加了 lua）：
#   * 24.10 的 luci-base 是 26.x 纯 JS 架构，菜单改由 /usr/share/luci/menu.d/*.json
#     定义，**不再扫描 /usr/lib/lua/luci/controller/*.lua**，Lua 控制器写了也不会生效
#   * 固件里**没有 lua 解释器**，menu.json 的 template action 渲染时直接报
#     "No Lua runtime installed" → 500
#   * 本页只用 busybox ash + uhttpd 的 cgi_prefix，零新增依赖，580MHz 上秒开
#
# 定位：**隧道断了也能用**。
#   服务器页（Ubuntu）依赖隧道 → 隧道依赖 WAN → 现场一换热点隧道就断
#   → 服务器页连不上网关 → 改不了 WiFi → 死锁。
#   破这个死锁的唯一途径就是本地页，所以 **WiFi 上行必须在本地改**。
#
# 与服务器页的分工：服务器页 = 远程集中管理；本页 = 现场应急 + 离线排障。

CONF=/etc/r1c/site.conf
APPLY_LOG=/tmp/r1c-apply.log
WIFI_LOG=/tmp/r1c-wifi.log
TMPD=/tmp/r1c-web
BACKUP_KEEP=5

mkdir -p "$TMPD"

# ---------------------------------------------------------------------------
# 工具函数
# ---------------------------------------------------------------------------

# HTML 转义（所有回显到页面的值都必须过一遍，否则配置里的字符会破坏页面结构）
h() {
    printf '%s' "${1:-}" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'
}

# URL 解码：依赖 busybox printf 的 %b 支持 \xHH（实测可用）
urldecode() {
    printf '%b' "$(printf '%s' "${1:-}" | sed -e 's/+/ /g' -e 's/%\([0-9A-Fa-f][0-9A-Fa-f]\)/\\x\1/g')"
}

# 从 site.conf 读某个键的值（支持 PLC_DEVICES 这种跨行引号值）
conf_get() {
    [ -f "$CONF" ] || return 0
    awk -v K="$1" '
    {
        if (m) { if ($0 ~ /^[[:space:]]*"/) exit; print; next }
    }
    /^[A-Za-z_][A-Za-z0-9_]*=/ {
        k = $0; sub(/=.*$/, "", k)
        if (k == K) {
            v = $0; sub(/^[^=]*=/, "", v)
            sub(/^[[:space:]]*"/, "", v)
            if (v ~ /"/) { sub(/"[[:space:]]*(#.*)?$/, "", v); print v; exit }
            print v; m = 1
        }
    }' "$CONF"
}

# 把 KEY 的值整体替换掉。
# 值从文件读（而不是 -v 传参）：避免值里出现换行/引号时把 awk 参数搞坏，
# 也顺带避开了 sed 替换时对 & / \ 的转义地狱。
conf_set() {
    _k="$1"; _vf="$2"
    [ -f "$CONF" ] || : > "$CONF"
    awk -v K="$_k" -v VF="$_vf" '
    # ⚠️ 单行键必须写成 KEY="value"。
    #    第一版统一写成跨行引号（KEY="\nvalue\n"），结果值里混进了换行符 ——
    #    shell 把它 source 进来后 WG_ENDPOINT / VPN_ADDR 全都带 \n，r1c-apply 直接配错。
    #    只有 PLC_DEVICES（或值本身多于一行）才用跨行格式。
    function loadval() {
        nv = 0
        close(VF)
        while ((getline t < VF) > 0) val[++nv] = t
    }
    function emit(tail) {
        if (nv <= 1 && K != "PLC_DEVICES") {
            printf "%s=\"%s\"%s\n", K, (nv ? val[1] : ""), tail
        } else {
            printf "%s=\"\n", K
            for (i = 1; i <= nv; i++) print val[i]
            print "\"" tail
        }
    }
    BEGIN { found = 0; inm = 0 }
    {
        if (inm) {                       # 原多行值的内部，原样丢弃
            if ($0 ~ /^[[:space:]]*"/) inm = 0
            next
        }
        if ($0 ~ /^[A-Za-z_][A-Za-z0-9_]*=/) {
            k = $0; sub(/=.*$/, "", k)
            if (k == K) {
                found = 1
                tail = ""
                if ($0 ~ /"[[:space:]]*#/) tail = " " substr($0, index($0, "#"))
                loadval(); emit(tail)
                rest = $0; sub(/^[^=]*=/, "", rest)
                if (rest ~ /^[[:space:]]*"[^"]*$/) inm = 1   # 值没闭合 → 多行
                next
            }
        }
        print
    }
    END { if (!found) { loadval(); emit("") } }' "$CONF" > "$CONF.new" && mv "$CONF.new" "$CONF"
}

# 把多行文本写成"值文件"（去掉空行；全空时保留一个空行，与原文件风格一致）
mkval() {
    printf '%s\n' "${1:-}" | grep -v '^[[:space:]]*$' > "$2"
    [ -s "$2" ] || printf '\n' > "$2"
}

# TCP 端口探测。busybox nc 没有 -w/-z，系统里也没有 timeout，
# 不自建超时的话，对 filtered 端口会永久阻塞整个页面。
probe_tcp() {
    ( nc "$1" "$2" </dev/null >/dev/null 2>&1 ) &
    _p=$!
    ( sleep 2; kill -9 "$_p" 2>/dev/null ) &
    _k=$!
    wait "$_p" 2>/dev/null
    _rc=$?
    kill -9 "$_k" 2>/dev/null
    return $_rc
}

backup_conf() {
    cp "$CONF" "$CONF.bak.$(date +%Y%m%d%H%M%S)" 2>/dev/null
    # 只留最近几份，别把 flash 撑爆
    ls -1t "$CONF".bak.* 2>/dev/null | tail -n +$((BACKUP_KEEP + 1)) | while read -r f; do rm -f "$f"; done
}

# ---------------------------------------------------------------------------
# 访问控制：只允许从 LAN 侧 / VPN 侧打开，拒绝从 WAN 进来
# 判定方法：看通往来源地址的路由从哪个接口出去 —— 默认路由的出口就是 WAN。
# ---------------------------------------------------------------------------
guard() {
    _wan=$(ip route 2>/dev/null | awk '/^default /{print $5; exit}')
    _dev=""
    [ -n "${REMOTE_ADDR:-}" ] && _dev=$(ip route get "$REMOTE_ADDR" 2>/dev/null | head -1 \
        | sed -n 's/.*dev \([A-Za-z0-9_.:@-]*\).*/\1/p')
    case "$_dev" in
        ""|lo) ;;                       # 本机/无法判定（本地执行）时放行
        "$_wan") deny "不允许从 WAN 侧访问本页（来源 $_dev）" ;;
        *) ;;                           # br-lan、wg0 等内网接口
    esac
}

deny() {
    printf 'Content-Type: text/plain; charset=utf-8\r\n\r\n'
    printf '403 Forbidden: %s\n' "$1"
    exit 0
}

# ---------------------------------------------------------------------------
# 页面框架
# ---------------------------------------------------------------------------
