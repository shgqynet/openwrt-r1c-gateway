    _title="$1"; _refresh="$2"
    printf 'Content-Type: text/html; charset=utf-8\r\n'
    printf 'Cache-Control: no-store\r\n'
    printf '\r\n'
    cat <<EOF
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
EOF
    [ -n "$_refresh" ] && printf '<meta http-equiv="refresh" content="%s">\n' "$_refresh"
    printf '<title>%s — R1C 网关</title>\n' "$(h "$_title")"
    cat <<'EOF'
<style>
body{margin:0;background:#f5f6f8;color:#222;font:14px/1.6 -apple-system,"Microsoft YaHei",sans-serif}
.wrap{max-width:960px;margin:0 auto;padding:16px}
h1{font-size:18px;margin:0 0 4px}
.sub{color:#888;font-size:12px;margin-bottom:14px}
