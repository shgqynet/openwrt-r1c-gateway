input[type=text],input[type=password],select,textarea{width:100%;max-width:460px;padding:6px 8px;border:1px solid #ccd2d8;border-radius:4px;font-size:13px;box-sizing:border-box}
textarea{font-family:monospace;min-height:80px}
button{margin-top:14px;padding:8px 18px;background:#1a73c7;color:#fff;border:0;border-radius:4px;font-size:14px;cursor:pointer}
button.warn{background:#c62828}
.hint{color:#888;font-size:12px;margin-top:3px}
.warnbox{background:#fff8e1;border:1px solid #ffe0b2;border-radius:4px;padding:8px 12px;margin-bottom:12px;font-size:13px}
