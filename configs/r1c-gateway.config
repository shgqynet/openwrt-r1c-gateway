# ==============================================================================
# R1C Industrial Remote Gateway — 编译配置
#
# 设备   : Xiaomi MiWiFi Mini (R1C)
# Target : ramips / mt7620 / xiaomi_miwifi-mini
# 架构   : mipsel_24kc        源码: openwrt/openwrt openwrt-24.10 (kernel 6.6)
# Flash  : 16 MiB (firmware 分区 15872 KiB)
#
# 设计原则（需求 §72）：稳定性 > 安全性 > PLC 兼容性 > 自动恢复 > 易用性 > UI
# 只保留 WAN → VPN → PLC LAN 主线所需组件。
# ==============================================================================

# ---------------------------------------------------------------- Target
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7620=y
CONFIG_TARGET_ramips_mt7620_DEVICE_xiaomi_miwifi-mini=y

# 禁用一切 x86/软路由残留（参考仓库原有配置）
# CONFIG_TARGET_x86 is not set
# CONFIG_TARGET_ROOTFS_PARTSIZE is not set
# CONFIG_VMDK_IMAGES is not set

# ---------------------------------------------------------------- 基础系统（§45）
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# ---- LuCI 简体中文语言包（现场为中文环境，2026-10-06 增）----
# ⚠️ 2026-10-07 踩坑：kconfig 不接受 `CONFIG_PACKAGE_x=y   # 注释` 这种行尾注释，
#    该行会被静默忽略 —— 编译全绿、rootfs 里却一个 *.zh-cn.lmo 都没有，
#    直到 90 分钟构建结束才在验收步骤暴露（第 9 次构建 37490730637）。
#    【规则】=y 行必须独占一行且行尾干净，说明一律写成独立的 # 注释行。
# 包名已对 openwrt-24.10 luci.mk 逐个核过（LUCI_LC_ALIAS.zh_Hans=zh-cn，
# po 目录名是 zh_Hans，产出的包名与 lmo 后缀却是 zh-cn，两者别混）。
# luci = luci-light(含 luci-app-firewall/luci-mod-admin-full) + luci-app-package-manager
# 体积参考：base 140 KiB / firewall 30 KiB / package-manager 20 KiB / mwan3 20 KiB
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y
# 打开 LUCI_LANG_zh_Hans 后，其余已选 luci 模块（network / status / system /
# admin-full 等）的中文包按 luci.mk 的 DEFAULT 一并置 y，界面中文覆盖更完整。
CONFIG_LUCI_LANG_zh_Hans=y
# 注：luci-proto-wireguard 官方无 i18n 包，该协议页少量字段仍为英文，可接受。
# 默认语言由 uci-defaults/91-r1c-luci-lang.sh 设为 zh_cn。
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_procd=y
CONFIG_PACKAGE_dnsmasq=y
# 不用 dnsmasq-full（省空间，无 DNS 劫持需求）
# CONFIG_PACKAGE_dnsmasq-full is not set

# ---------------------------------------------------------------- 无线（§12 手机热点 WAN）
# 2.4G: SoC rt2800 (默认包已含 kmod-rt2800-soc)  5G: PCIe mt76x2 (DEVICE_PACKAGES)
#
# 【WPA3 决策 2026-09-23，用户确认】不使用 WPA3，保持 wpad-basic-mbedtls（WPA2/WPA2-PSK）。
#   现场场景为普通手机热点，WPA2 安全强度已足够。
#   换 wpad-openssl 会引入 libopenssl 依赖树并增加 Flash 占用，收益不匹配。
#   若将来确有 WPA3 需求，再评估改选；届时对照 §43/§44 重算 Flash 预算。
CONFIG_PACKAGE_kmod-mt76x2=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set
# CONFIG_PACKAGE_wpad-openssl is not set
# CONFIG_PACKAGE_wpad is not set

# ---------------------------------------------------------------- USB（§13/§14）
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-net=y
# Android USB Tethering (RNDIS) + 通用 CDC ECM
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_usbutils=y
# usb-modeswitch：4G 模块插上默认是 U 盘/光盘模式（如华为 12d1:1f01），
#   不切换就永远只是个存储设备、不会产出网络接口。装包后由 hotplug 自动切换。
#   2026-10-08 真机实测：华为 E3131 装完自动 1f01 -> 14db，cdc_ether 随即注册 eth1，
#   拿到 192.168.31.150，ping 223.5.5.5 55ms —— 缺的就是这一个包。
CONFIG_PACKAGE_usb-modeswitch=y
# 以下为非 HiLink（PPP/QMI/MBIM 型）模块的兼容性预留，体积都很小（合计 < 300 KiB）：
#   本设备用的华为 E3131 是 HiLink（免拨号，cdc_ether 即可），这些对它非必需，
#   但换其他型号模块时能直接开箱可用，不用再跑一轮 95 分钟构建。
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_umbim=y

# ---------------------------------------------------------------- VPN：WireGuard（PRIMARY，§5/§8）
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_kmod-tun=y

# ---------------------------------------------------------------- VPN：ZeroTier（OPTIONAL，§5）
# 实测：zerotier 1.14.1-r3 mipsel_24kc，ipk 0.48MiB / installed 1.0MiB
# 默认安装但服务默认关闭（需求 §29：Remote Access 默认 OFF）
CONFIG_PACKAGE_zerotier=y
# CONFIG_PACKAGE_luci-app-zerotier is not set   # 省空间，用 UCI + r1c-status 管理

# ---------------------------------------------------------------- 明确不装（§46 / VPN 兼容性结论）
# Tailscale：installed 24.9 MiB，远超 Flash 预算 → 不装（EXPERIMENTAL，不入固件）
# CONFIG_PACKAGE_tailscale is not set
# cloudflared：installed 25.9 MiB + WARP routing 不转发 ICMP → NOT SUPPORTED ON R1C
# CONFIG_PACKAGE_cloudflared is not set
# Docker / Python / Node.js / Samba / Transmission / AdGuardHome → 全部不装
# CONFIG_PACKAGE_luci-app-dockerman is not set
# CONFIG_PACKAGE_python3 is not set
# CONFIG_PACKAGE_node is not set
# CONFIG_PACKAGE_samba4-server is not set
# CONFIG_PACKAGE_luci-app-transmission is not set
# CONFIG_PACKAGE_adguardhome is not set
# 家用/软路由插件全部剔除
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_luci-app-autoreboot is not set
# CONFIG_PACKAGE_snmpd is not set

# ---------------------------------------------------------------- 多 WAN（§15）
# Flash 紧张时可关闭；mwan3 用于 WAN 优先级切换
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y

# ---------------------------------------------------------------- 时间同步（§19）
# 必须先 NTP 再起 VPN；LEDN 默认含 ntpd
CONFIG_PACKAGE_ntpd=y

# ---------------------------------------------------------------- 诊断工具（轻量）
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iputils-ping=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y

# ---------------------------------------------------------------- 日志（§42）
# 默认 RAM log，禁止高频写 Flash
CONFIG_PACKAGE_logd=y

# ---------------------------------------------------------------- 版本（由 build.sh 注入）
CONFIG_VERSION_NUMBER=""
